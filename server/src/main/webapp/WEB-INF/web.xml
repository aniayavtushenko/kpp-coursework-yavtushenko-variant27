<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>EquipmentServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.EquipmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EquipmentServlet</servlet-name>
        <url-pattern>/equipment</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>ResearcherServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ResearcherServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResearcherServlet</servlet-name>
        <url-pattern>/researchers</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>BookingServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.BookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookingServlet</servlet-name>
        <url-pattern>/bookings</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>UsageRecordServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.UsageRecordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UsageRecordServlet</servlet-name>
        <url-pattern>/usage-records</url-pattern>
    </servlet-mapping>

</web-app>